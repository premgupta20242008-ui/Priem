# GEMINI_API_KEY: Required for Gemini AI API calls (if used)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet or bot web dashboard is hosted
APP_URL="https://your-app.onrender.com"

# TELEGRAM_BOT_TOKEN: The Bot Token from @BotFather (Required for 24/7 Bot Polling)
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# Server Port (Default: 3000)
PORT=3000

# Environment mode (production for hosted deployments)
NODE_ENV="production"
